    "overlay": {
      "color": "secondary",
      "opacity": 0.4
    },
    "logoVariantOnImage": "white",
    "note": "Role-tagged library in images/manifest.json (orchestral, Velvet Score; generated + treated Unsplash). 'treatment' is the PREFERRED look \u2014 advisory; downstream (format-MCP/website) may override to harmonise a deck. Named looks in expression.treatments apply downstream; overlay is a legibility scrim."
  },
  "website": {
    "archetype": "sage",
    "aesthetic": "editorial-systems",
    "layout": {
      "density": "measured",
      "symmetry": "balanced",
      "flowDirection": "stack",
      "heroStyle": "editorial-stack",
      "gridSystem": "structured-2col",
      "sectionSpacing": "generous",
      "sectionDividers": "motif-band",
      "footerStyle": "indexed",
      "whitespaceStrategy": "measured"
    },
    "texture": {
      "backgroundTreatment": "solid",
      "surfaceFinish": "matte",
      "borderStyle": "thin-line",
      "shadowDepth": "none",
      "cornerRadius": "sharp",
      "overlayStyle": "brand-tint",
      "patternDensity": "none"
    },
    "typography": {
      "headingStyle": "display-serif",
      "headingScale": 1.35,
      "bodyLineHeight": 1.7,
      "letterSpacing": "tight",
      "textTransform": "none",
      "pullQuoteStyle": "serif-led",
      "listStyle": "mono-indexed"
    },
    "motion": {
      "intensity": "moderate",
      "revealStyle": "clip-reveal",
      "scrollBehavior": "smooth",
      "hoverBehavior": "color-shift",
      "transitionSpeed": "cinematic",
      "loadingAnimation": "stagger-fade",
      "cursorStyle": "default"
    },
    "components": {
      "navigation": "sticky-minimal",
      "cards": "bordered",
      "buttons": "outline",
      "forms": "minimal-underline",
      "imagePresentation": "full-bleed",
      "testimonials": "quote-panel",
      "ctaStyle": "inline",
      "socialProof": "case-facts",
      "codeBlocks": "terminal-style"
    },
    "colorApplication": {
      "darkSections": true,
      "darkSectionFrequency": 3,
      "accentUsage": "balanced",
      "gradientDirection": "none",
      "colorBlockSections": true,
      "imageOverlayBehavior": "brand-tint"
    },
    "pages": {
      "home": {
        "enabled": true,
        "sections": [
          {
            "type": "hero",
            "variant": "split"
          },
          {
            "type": "service",
            "variant": "capability-grid"
          },
          {
            "type": "stats",
            "variant": "counter-band"
          },
          {
            "type": "case-study",
            "variant": "featured-card"
          },
          {
            "type": "content",
            "variant": "tech-teaser"
          },
          {
            "type": "cta",
            "variant": "full-width-band"
          }
        ]
      },
      "about": {
        "enabled": true
      },
      "services": {
        "enabled": true
      },
      "case-studies": {
        "enabled": true
      },
      "blog": {
        "enabled": true
      },
      "contact": {
        "enabled": true
      }
    },
    "deployment": {
      "platform": "azure-swa",
      "domain": "stromy.com.au",
      "analytics": "plausible",
      "contactForm": "formspree"
    }
  },
  "document": {
    "margins": {
      "top": "1in",
      "bottom": "1in",
      "left": "1in",
      "right": "1in"
    },
    "header": {
      "content": "STROMY",
      "logo": true
    },
    "footer": {
      "content": "Confidential",
      "pageNumbers": true
    },
    "headingColor": "primary",
    "tableHeaderColor": "primary"
  },
  "presentation": {
    "slideMargin": "40pt",
    "titleMargin": "30pt",
    "contentMargin": "20pt",
    "aspectRatio": "16:9"
  },
  "video": {
    "resolution": "1920x1080",
    "fps": 30
  },
  "formatting": {
    "headingThreshold": 24,
    "accentCycleColors": [
      "primary",
      "accent",
      "success"
    ],
    "autoContrastText": true
  },
  "plotly": {
    "categoricalPalette": [
      "#61009E",
      "#31004F",
      "#1E462F",
      "#9B7BB8",
      "#5C5C66",
      "#E5D2FA"
    ],
    "defaultHeight": 500,
    "titleFontSize": 18,
    "axisFontSize": 12,
    "legendFontSize": 11,
    "margins": {
      "top": 80,
      "bottom": 70,
      "left": 60,
      "right": 50
    },
    "baseTemplate": "plotly_white",
    "gridColor": "#E3DCEC",
    "secondaryTextColor": "#6E6A75",
    "bar": {
      "markerColor": "#31004F",
      "markerLineColor": "#1C0030",
      "markerLineWidth": 1
    },
    "line": {
      "color": "#31004F",
      "width": 2.5,
      "markerColor": "#61009E",
      "markerSize": 7
    },
    "scatter": {
      "markerColor": "#61009E",
      "markerSize": 8,
      "markerLineWidth": 0
    },
    "pie": {
      "hole": 0.4,
      "textfontSize": 13,
      "markerLineColor": "#FFFFFF",
      "markerLineWidth": 2
    },
    "sentiment": {
      "positiveColor": "#1E462F",
      "neutralColor": "#9A9AA4",
      "negativeColor": "#8E2F4F"
    }
  },
  "excalidraw": {
    "strokeColor": "#31004F",
    "backgroundColor": "#FFFFFF",
    "fillColors": [
      "#61009E",
      "#31004F",
      "#1E462F",
      "#E5D2FA",
      "#9B7BB8",
      "#5C5C66"
    ],
    "textColor": "#16161A",
    "fontFamily": 2,
    "fontSize": 16,
    "strokeWidth": 2,
    "roughness": 0,
    "arrowColor": "#5C5C66",
    "labelFontSize": 14
  },
  "placeholderPolicy": {
    "brandFields": [
      "brandName",
      "tagline",
      "domain",
      "logoPath"
    ],
    "externalFields": [
      "sender.name",
      "sender.title",
      "sender.email",
      "sender.phone",
      "sender.mobile",
      "sender.address"
    ],
    "fallback": "placeholders",
    "placeholderFormat": "{{fieldName}}"
  },
  "identity": {
    "archetype": {
      "primary": "sage",
      "secondary": "magician",
      "status": "approved",
      "rationale": "Primary Sage: knowledge authority, editorial restraint, evidence-first \u2014 sourced from guidelines.md \u00a71 archetype decision (user-approved 2026-04-07) and confirmed by website.archetype='sage'. Secondary Magician: transformative complex-to-simple edge, visionary but grounded \u2014 also sourced from guidelines.md \u00a71 and build-log Phase 0 decision."
    },
    "essence": "STROMY transforms complex workflows into orchestrated intelligence.",
    "positioning": "For corporates and consulting agencies drowning in unstructured processes, STROMY is the AI orchestration partner that designs and builds analytical workflows \u2014 from media research to crisis management to strategy audits \u2014 delivering the structured, trust-grade outputs their stakeholders expect. Unlike generic AI consultancies, Stromy brings the maestro's precision: every workflow is composed, every output is publication-ready.",
